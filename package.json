{
  "name": "stanley",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "dev": "pnpm --filter @stanley/desktop dev",
    "build": "pnpm --filter @stanley/desktop build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "models": "node scripts/download-models.mjs",
    "eval": "pnpm --filter @stanley/evals eval",
    "eval:voice": "pnpm --filter @stanley/evals eval:voice",
    "eval:web": "pnpm --filter @stanley/evals eval:web",
    "eval:working": "pnpm --filter @stanley/evals eval:working",
    "eval:answer": "pnpm --filter @stanley/evals eval:answer",
    "eval:layout": "pnpm --filter @stanley/evals eval:layout",
    "eval:dictate": "pnpm --filter @stanley/evals eval:dictate",
    "smoke:desktop": "pnpm build && pnpm --filter @stanley/evals smoke:desktop",
    "eval:stt": "pnpm --filter @stanley/evals eval:stt",
    "eval:turn": "pnpm --filter @stanley/evals eval:turn",
    "clips:label": "pnpm --filter @stanley/evals clips:label"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
