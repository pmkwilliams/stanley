# Vercel AI Gateway — Jev (typesafe-ai/jev) and Sonnet 5.5
AI_GATEWAY_API_KEY=
# Parallel Search API
PARALLEL_API_KEY=
# Subquadratic Decisions API — SubQ Snap, used instead of Jev when STANLEY_DECIDER=subq
