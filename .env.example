# Vercel AI Gateway — Jev (typesafe-ai/jev) and Sonnet 5.5
AI_GATEWAY_API_KEY=
# Parallel Search API
PARALLEL_API_KEY=
# Jamendo (Creative Commons music for the Music app); free client id from https://devportal.jamendo.com
# Unset: Music plays its three bundled demo tracks and has no search.
JAMENDO_CLIENT_ID=
# The folder of the user's files that Stanley works in (macOS). Unset: ~/Stanley.
STANLEY_FILES=
# Philips Hue (Lights app): found on the network by itself; set the bridge's address if it isn't.
HUE_BRIDGE=
