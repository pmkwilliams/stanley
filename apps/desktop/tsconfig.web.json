{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/renderer/src/**/*",
    "gallery/**/*.ts",
    "gallery/**/*.svelte",
    "src/preload/*.d.ts",
    "src/shared",
    "../../packages/app-*/src/**/*.svelte",
    "../../packages/app-ui/src/**/*.ts"
  ]
}
